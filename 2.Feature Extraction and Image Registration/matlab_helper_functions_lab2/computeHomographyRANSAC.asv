
function [H12,S1,S2] = computeHomographyRANSAC(CL1uv,CL2uv,Model)
 
% computeHomography : estimate the Homography between two images according to Model 
%           Cluv1    set of points on image1 . Each row represents a 2-D point
%                       (u,v). Size: Nx2, with N number of points.
%           Cluv2    set of points on image2 . Each row represents a 2-D point
%                       (u,v). Size: Nx2, with N number of points.
%           Model       type of Homography to estimate. It has to be egual
%                       to one of the following strings: 'Translation',
%                       'Rigid', 'Similarity', 'Affine', 'Projective'.
%   Output
%           H12           estimated Homography of Model type. 3x3 matrix.
%           S1 , S2
%
    H12 = [];
    S1 =[];
    S2 = [];
    %%function to calaculate the number of iterations based on
    %% probability and s
    function numIterations = calculateRANSACIterations(desiredProbability, alpha, s)
         numIterations = ceil(log(1 - desiredProbability) / log(1 - alpha^s));
    end
    %% Generates the Random subset of samples  
    function [subset1,subset2] = getRandomSubset(s)
        subsetIndices = datasample(1:number_points, s , 'Replace', false);
        subset1 = CL1uv(subsetIndices, :);
        subset2 = CL2uv(subsetIndices, :);
    end
   %% returns the number of subset of inliers
    function [S1 ,S2,inlier_indexs ] = findInliers(H12)
        errorVec = projectionerrorvec(H12,CL1uv,CL2uv);
        condition = errorVec < threshold_dis ;
        inlier_indexs= find(condition)  ;   
        S1 = CL1uv(inlier_indexs , :);
        S2 = CL2uv(inlier_indexs , :);

    end
    
    number_points = size(CL1uv,1);
    desiredProbability = 0.95;  % Choose your desired confidence level
    alpha = 0.8;  % Your desired probability of a point being an inlier
    threshold_dis = 1;
    num_inlier_threshold  = alpha*number_points;
    

    switch(Model)

        case 'Translation'
        % Compute here your 'similarity ' homography
        % set number of points
        s=2;  % s=2 for Translation 
        % calculate the number of itrations 
        numIterations = calculateRANSACIterations(desiredProbability, alpha, s);

        for iter= 1:numIterations
            % step 1 : Randomly select a subset of points  s 
            [subset1,subset2] = getRandomSubset(s);

            % step 2 : Fit the Homography
            H12 = compute_trans_homg(subset1,subset2,s);
            % Step 3: Find inliers
            [S1_temp , S2_temp , inlier_indexs] = findInliers(H12);
          
            % if the new consensus less than continue with out doing
            % nothing
            if(size(S1_temp,1) < size(S1))
                   continue;
            end
               % replace the best subset with highest number of match
             S1 = S1_temp; 
             S2 = S2_temp;
              
             % if the number of inliers are above the treshold
             % terminate 
             if(length(inlier_indexs) > num_inlier_threshold)                 
                 break ; 
             end
            % return the best homography with 
                        
        end
         % re-estimate the model using all the points in Si 
         % calculate the best homography with
         H12 = compute_trans_homg(S1,S2,size(S1,1));
     
        case 'Similarity'
        
            % Compute here your 'Similarity' homography
            % calculate the number of itrations 
            % set number of points
            s=2;  % s=2 for Similarity    
            % get number of iterations based on s
            numIterations = calculateRANSACIterations(desiredProbability, alpha, s);
    
            for iter= 1:numIterations
                % step 1 : Randomly select a subset of points  s 
                [subset1,subset2] = getRandomSubset(s);
                
                % step 2 compute homography model
                H12 = compute_similarity_homg(subset1 , subset2 ,s);
                % Step 3: Find inliers

                [S1_temp , S2_temp , inlier_indexs] = findInliers(H12);
                
                % if the new consensus less than continue with out doing
                % nothing
                if(size(S1_temp,1) < size(S1))
                   continue;
                end
                % replace the best subset with highest number of match
                S1 = S1_temp; 
                S2 = S2_temp;
              
                % if the number of inliers are above the treshold
                % terminate 
                if(length(inlier_indexs) > num_inlier_threshold)                 
                   break ; 
                end
                            
            end
             % re-estimate the model using all the points in Si 
             % calculate the best homography with
             H12 = compute_similarity_homg(S1,S2,size(S1,1));
         
         case 'Affine'
            % set the number of points
            s=3;  % s=3 for Affain 
            % get number of iterations

            numIterations = calculateRANSACIterations(desiredProbability, alpha, s);       
            for iter= 1:numIterations
                
                % step 1 : Randomly select a subset of points  s 
                [subset1,subset2] = getRandomSubset(s);
                         
                % step 2 : Fit the Homography 
                % H12 = compute_affain_homg(subset1,subset2,s);
    
                % Step 3: Find inliers
                
                [S1_temp , S2_temp , inlier_indexs] = findInliers(H12);
               
               % if the new consensus less than continue with out doing
               % nothing
              if(size(S1_temp,1) < size(S1))
                   continue;
              end
              % replace the best subset with highest number of match
              S1 = S1_temp; 
              S2 = S2_temp;
              
              % if the number of inliers are above the treshold
              % terminate 
              if(length(inlier_indexs) > num_inlier_threshold)                 
                   break ; 
              end
              
            end
            
             % re-estimate the model using all the points in Si 
             % calculate the best homography with
             H12 = compute_affain_homg(S1,S2,size(S1,1));
                
         case 'Projective'
            s=4;  % s=4 for Projective 
            numIterations = calculateRANSACIterations(desiredProbability, alpha, s);
  
            for iter= 1:numIterations
                % step 1 : Randomly select a subset of points  s 
                [subset1,subset2] = getRandomSubset(s);
                
                
                % step 2 : Fit the Homography 
                % Compute here your homography
                % H12 = compute_proj_homeg(subset1,subset2,s);

                % Step 3: Find inliers
                [S1_temp , S2_temp , inlier_indexs] = findInliers(H12);
    
               
               % if the new consensus less than continue with out doing
               % nothing
              if(size(S1_temp,1) < size(S1))
                   continue;
              end
              % replace the best subset with highest number of match
              S1 = S1_temp; 
              S2 = S2_temp;
              
              % if the number of inliers are above the treshold
              % terminate 
              if(length(inlier_indexs) > num_inlier_threshold)                 
                   break ; 
              end
                            
            end
             % re-estimate the model using all the points in Si 
             % calculate the best homography with
             H12 = compute_proj_homeg(S1,S2,size(S1,1));

         
        
        otherwise
            warning('Invalid model, returning identity homography');
            H12 = eye(3);
            
    end
  
    function H12 = compute_proj_homeg(subset1,subset2,s)
          % compute projective homography 
            Q = zeros(2*s,8);
            B = zeros(2*s,1);
            % A=[];
            for i=1:s
                Q(2*i-1,:) = [subset2(i,:),1,0,0,0,-subset2(i,1)*subset1(i,1), -subset2(i,2)*subset1(i,1)];
                Q(2*i,:) = [0,0,0,subset2(i,:),1,-subset2(i,1)*subset1(i,2), -subset2(i,2)*subset1(i,2) ];
                B(2*i-1,1) = subset1(i,1);
                B(2*i,1) = subset1(i,2);
            end

            A =Q\B; % Getting the unkown variables in colomun vector
            A = [A;1]; % add 1 at the end of homogenous 

            H12 = reshape(A,3,3)'; % getting the estimated P by reshaping the calculated unkown variables 

     end

     function H12 = compute_affain_homg(subset1,subset2,s)
           % step 2 : Fit the Homography 
           % Compute here your 'Affine' homography
            Q = zeros(2*s,6);
            B = zeros(2*s,1);
            disp(subset1)
            for i=1:s
                Q(2*i-1,:) = [subset2(i,:),1,0,0,0];
                Q(2*i,:) = [0,0,0,subset2(i,:),1];
                B(2*i-1,1) = subset1(i,1);
                B(2*i,1) = subset1(i,2);
             end
            
            A = Q\B; % Getting the unkown variables in colomun vector
            % getting the estimated Homography by reshaping the calculated unkown variables 
            H12 = [ A(1) A(2) A(3)
                    A(4) A(5) A(6)
                    0     0    1 ];
     end

    function H12 = compute_similarity_homg(subset1 , subset2,s)
        % step 2 : Fit the Homography 
        Q = zeros(2*s,4);
        B = zeros(2*s,1);
        for i=1:s
            Q(2*i-1,:) = [subset2(i,1),-subset2(i,2),1,0];
            Q(2*i,:) = [subset2(i,2),subset2(i,1),0,1];
            B(2*i-1,1) = subset1(i,1);
            B(2*i,1) = subset1(i,2);
        end   
        A =Q\B;

        % getting the estimated Homography by replacing the calculated unkown variables 
        H12 = [ A(1) -A(2) A(3)
                A(2)  A(1) A(4)
                 0     0    1 ];

    end

    function H12 = compute_trans_homg(subset1,subset2,s)

        difference = subset1 - subset2 ;
        Q = zeros(2*s,2);
        B = zeros(2*s,1);
        for i=1:s
            Q(2*i-1,:) = [1,0];
            Q(2*i,:) = [0,1];
            B(2*i-1,1) = difference(i,1);
            B(2*i,1) = difference(i,2);
        end   
        A =Q\B;

        % getting the estimated Homography by replacing the calculated unkown variables 
        H12 = [ 1  0  A(1)
                0  1  A(2)
                0  0  1 ];
    end
    
  end





