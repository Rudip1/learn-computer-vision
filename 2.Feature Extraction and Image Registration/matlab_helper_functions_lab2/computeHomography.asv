

function H12 = computeHomography(CL1uv,CL2uv, Model)

% computeHomography : estimate the Homography between two images according to Model 
%           Cluv1    set of points on image1 . Each row represents a 2-D point
%                       (u,v). Size: Nx2, with N number of points.
%           Cluv2    set of points on image2 . Each row represents a 2-D point
%                       (u,v). Size: Nx2, with N number of points.
%           Model       type of Homography to estimate. It has to be egual
%                       to one of the following strings: 'Translation',
%                       'Rigid', 'Similarity', 'Affine', 'Projective'.
%   Output
%           H12           estimated Homography of Model type. 3x3 matrix.
%
    number_points = size(CL1uv,1);
    switch(Model)

        case 'Translation'            
            % Compute here your 'Translation' homography
        difference = CL1uv - CL2uv ;
        Q = zeros(2*number_points,2);
        B = zeros(2*s,1);
        for i=1:number_points
            Q(2*i-1,:) = [1,0];
            Q(2*i,:) = [0,1];
            B(2*i-1,1) = difference(i,1);
            B(2*i,1) = difference(i,2);
        end   
        A =Q\B;

        % getting the estimated Homography by replacing the calculated unkown variables 
        H12 = [ 1  0  A(1)
                0  1  A(2)
                0  0  1 ]; 
                 
        case 'Similarity'
            
            % Compute here your 'Similarity' homography
            Q = zeros(number_points,4);
            B = zeros(number_points,1);
            for i=1:number_points
                Q(2*i-1,:) = [CL2uv(i,1),-CL2uv(i,2),1,0];
                Q(2*i,:) = [CL2uv(i,2),CL2uv(i,1),0,1];
                B(2*i-1,1) = CL1uv(i,1);
                B(2*i,1) = CL1uv(i,2);
            end   
            A =Q\B;

            % getting the estimated Homography by reshaping the calculated unkown variables 
            H12 = [ A(1)  -A(2) A(3)
                    A(2)   A(1) A(4)
                     0     0    1 ];

            
        case 'Affine'
            
            % Compute here your 'Affine' homography
            Q = zeros(number_points,6);
            B = zeros(number_points,1);
            for i=1:number_points
                Q(2*i-1,:) = [CL2uv(i,:),1,0,0,0];
                Q(2*i,:) = [0,0,0,CL2uv(i,:),1];
                B(2*i-1,1) = CL1uv(i,1);
                B(2*i,1) = CL1uv(i,2);
            end
            A = Q\B; % Getting the unkown variables in colomun vector
           
            % getting the estimated Homography by reshaping the calculated unkown variables 
            H12 = [ A(1) A(2) A(3)
                    A(4) A(5) A(6)
                     0     0    1 ];
        
    
        
        case 'Projective'
            
            % Compute here your 'Projective' homography
            
           
            % initializing 
            Q=zeros(number_points,8);
            B= zeros(number_points,1);
            % callculate the projection matrices using method of hall 
            for i=1:number_points
        
                Q(2*i-1,:) = [CL2uv(i,:),1,0,0,0,-CL2uv(i,1)*CL1uv(i,1), -CL2uv(i,2)*CL1uv(i,1)];
                Q(2*i,:) = [0,0,0,CL2uv(i,:),1,-CL2uv(i,1)*CL1uv(i,2),   -CL2uv(i,2)*CL1uv(i,2) ];
                B(2*i-1,1) = CL1uv(i,1);
                B(2*i,1) = CL1uv(i,2);
        
            end 
            disp(Q)
            disp(B)
        
            A =Q\B; % Getting the unkown variables in colomun vector
            disp(A)
            A = [A;1];
        
            H12 = reshape(A,3,3)'; % getting the estimated P by reshaping the calculated unkown variables 
        
        
        otherwise
            warning('Invalid model, returning identity homography');
            H12 = eye(3);
            
    end
    
    
end





